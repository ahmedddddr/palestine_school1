{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "seeds-palestine-schools",
  "description": "Seeds Palestine Schools - Multi-Branch Management System",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**, data/**, server.js, migrate-files-to-mongodb.js",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|_next/|_static/|_vercel|[\\w-]+\\.\\w+).*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/login",
      "destination": "/api/index"
    },
    {
      "source": "/logout",
      "destination": "/api/index"
    },
    {
      "source": "/teacher",
      "destination": "/api/index"
    },
    {
      "source": "/master-control",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
