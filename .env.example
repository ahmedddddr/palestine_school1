# =============================================
# Seeds Palestine Schools - Environment Config
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# =============================================

# ---- Server ----
PORT=8000
# production | development
NODE_ENV=production

# ---- Database (RECOMMENDED FOR INTERNET DEPLOYMENT) ----
#
# OPTION A) Vercel Postgres (cloud, best for Vercel deployment):
#   1. Go to Vercel dashboard → Storage → Create Database → Postgres
#   2. Vercel will automatically set POSTGRES_URL environment variable
#   3. No additional configuration needed
#
# POSTGRES_URL=postgres://user:password@host:port/database
#
# OPTION B) Other PostgreSQL providers (Neon, Supabase, etc.):
#   Get connection string from your provider and set below:
#
# POSTGRES_URL=postgres://user:password@host:port/database
#
# OPTION C) Leave empty to store data as JSON files in ./data/ (default, not recommended for internet deployment)
POSTGRES_URL=

# Emergency fallback: keep using JSON files even if MONGODB_URI is set
FORCE_FILE_STORAGE=false

# ---- Session / Session Secret ----
# IMPORTANT: GENERATE YOUR OWN LONG RANDOM STRING (at least 32 chars).
# Anyone with this secret can forge session cookies.
#
# How to generate in terminal:
#   Node:    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Python:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-this-with-a-very-long-random-string-at-least-32-characters

# ---- Super Admin (Master Control) ----
# These are used ONLY for first-time setup when the users collection is empty.
# After that, manage users from inside the dashboard.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=ChangeThisToAStrongPassword123!

# ---- Default Branch Admin (first-run bootstrap) ----
# Default account for the first branch (branchId: 1). Only created on first run.
BRANCH_ADMIN_USERNAME=branchadmin
BRANCH_ADMIN_PASSWORD=ChangeThisToAStrongPassword456!

# ---- Security ----
# Set to 'true' if your app is behind a reverse proxy (nginx, Render, Cloudflare, Railway, etc.)
# that terminates TLS (HTTPS). Express will trust X-Forwarded-* headers.
TRUST_PROXY=true

# Rate Limiting
# Login attempts per IP in the window:
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=15
# General API requests per minute per IP:
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=500

# ---- CORS ----
# Leave as * unless you need cross-origin API access from another domain.
CORS_ORIGINS=*
